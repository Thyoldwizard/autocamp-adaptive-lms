# Server
PORT=3000
NODE_ENV=development

# Supabase — find these in your project's API settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM — set to "fallback" locally until Gemini is wired up
LLM_PROVIDER=fallback
GEMINI_API_KEY=your-gemini-api-key

# Migration runner — Supabase Personal Access Token (not the service role key)
# Generate one at: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token
