# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase — find these in your project's API settings ─────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Migration runner — Supabase Personal Access Token (not the service role key)
# Generate one at: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origin for the frontend (default: http://localhost:3001)
CORS_ORIGIN=http://localhost:3001

# ── LLM ───────────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER=gemini and supply GEMINI_API_KEY to enable real AI responses.
# Without a key the server automatically falls back to the deterministic provider.
LLM_PROVIDER=fallback
GEMINI_API_KEY=

# ── Signal sweep ──────────────────────────────────────────────────────────────
# Set to "true" to enable the background inactivity sweep (runs every INTERVAL ms).
ENABLE_SIGNAL_SWEEP=false
SIGNAL_SWEEP_INTERVAL_MS=3600000

# ── Seed ──────────────────────────────────────────────────────────────────────
# Password for all demo accounts created by npm run seed. Default: AtomCamp2026!
SEED_PASSWORD=

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: error | warn | info | debug  (default: info)
LOG_LEVEL=info

# ── Rules overrides (optional) ────────────────────────────────────────────────
# All are optional — omit to use built-in defaults.
# RULES_BAND_STRONG=0.7
# RULES_BAND_DEVELOPING=0.4
# RULES_ATRISK_RECENCY_WINDOW_MS=604800000
# RULES_COMPANION_MAX_HISTORY=10
