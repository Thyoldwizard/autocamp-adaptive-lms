# ── atomcamp frontend environment ─────────────────────────────────────────────
#
# Copy this file to .env.local and fill in the values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Backend API base URL (no trailing slash).
# Development default: http://localhost:3000/api (used when this var is absent).
# Production: set to your deployed backend, e.g. https://autocamp.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: canonical app URL used for OpenGraph metadataBase.
# Set this in production so OG image URLs resolve correctly.
# NEXT_PUBLIC_APP_URL=https://autocamp-lms.vercel.app
